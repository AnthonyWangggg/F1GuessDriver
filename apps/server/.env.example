# Copy to apps/server/.env. PostgreSQL is optional for P0 /api/health.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://f1:CHANGE_ME@localhost:5432/f1_driver_guess

# Set API_PROXY_TARGET in apps/web/.env if using a different backend port.


# Enable only after the separately reviewed daily migration.
DAILY_CHALLENGE_ENABLED=false

# Random matching remains off until separately approved expansion and release.
MATCHMAKING_ENABLED=false
