{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.cross.config.ts",
    "playwright.phase-e.config.ts",
    "apps/web/vite.config.ts",
    "apps/server/src/**/*.spec.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright.p4b.config.ts",
    "playwright.p4b-visual.config.ts",
    "playwright.p4g-visual.config.ts"
  ]
}
