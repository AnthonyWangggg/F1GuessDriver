# Copy to apps/server/.env. PostgreSQL is optional for P0 /api/health.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://f1:CHANGE_ME@localhost:5432/f1_driver_guess

# Set API_PROXY_TARGET in apps/web/.env if using a different backend port.

# For P1 copy this file to project root .env. Scripts also read apps/server/.env.
STATS_AS_OF=2026-10-08
IMPORT_RUN_ID=history-2026-10-08
# Optional dedicated PostgreSQL test database; tests use a disposable schema.
# TEST_DATABASE_URL=postgresql://f1:CHANGE_ME@localhost:5432/f1_driver_guess_test

# P2: creation default; sessions keep the version chosen at creation.
GAME_DATASET_VERSION=f1-2026-10-08-994df511b40814a5
# Set true for HTTPS; local HTTP uses false.
COOKIE_SECURE=false
# Optional comma-separated exact origins; no wildcard CORS.
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3000

NODE_ENV=development
TRUST_PROXY=none
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=15000
# Restore only to a NEW empty database with this prefix, never the source database.
# RESTORE_DATABASE_URL=postgresql://f1:CHANGE_ME@localhost:5432/f1_restore_test_p4a
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# BACKUP_KEY_FILE=<private-path-outside-release>/backup.key

# Enable these for an isolated 3.0 database after migrations and fixture setup.
IDENTITY_ENABLED=false
POINTS_ENABLED=false
MODES_ENTRY_ENABLED=false
QUICK_V2_ENABLED=false
DAILY_V2_ENABLED=false
BO3_ENABLED=false
BO3_RECOVERY_ENABLED=false
# IDENTITY_ENCRYPTION_KEY=<64 hex characters generated for this local database>
