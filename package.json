{
  "name": "f1-driver-guess",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "test:localization": "tsx scripts/test-localization-isolated.ts",
    "localization:audit": "tsx scripts/audit-localization.ts",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:build": "tsc -p tsconfig.deploy.json",
    "repository:prepare": "tsx scripts/prepare-clean-repository.ts",
    "licenses:inventory": "tsx scripts/license-inventory.ts",
    "licenses:evidence": "tsx scripts/fetch-license-evidence.ts",
    "publication:check": "tsx scripts/publication-check.ts",
    "release:pack": "tsx scripts/release-pack.ts",
    "release:inspect": "tsx scripts/release-check.ts",
    "release:smoke": "tsx scripts/release-smoke.ts",
    "test:e2e:p4a": "pnpm build && tsx scripts/test-p4a-browser.ts",
    "test:e2e:p4a:create": "pnpm build && tsx scripts/test-p4a-browser.ts --create",
    "release:check": "pnpm type-check && pnpm build && pnpm security:scan && pnpm release:pack && pnpm release:inspect",
    "security:scan": "tsx scripts/secret-scan.ts",
    "db:backup": "tsx scripts/database-backup.ts backup",
    "db:restore": "tsx scripts/database-backup.ts restore",
    "db:restore-drill": "tsx scripts/database-backup.ts drill",
    "db:verify-restore": "tsx scripts/verify-restore.ts",
    "data:v3": "pnpm --filter @f1/shared --filter @f1/database build && tsx scripts/publish-v3.ts",
    "data:analyze-v3": "tsx scripts/analyze-p33.ts",
    "game:v3-smoke": "pnpm --filter @f1/shared --filter @f1/database build && tsx scripts/smoke-v3-api.ts",
    "dev": "pnpm --filter @f1/shared --filter @f1/database build && pnpm --parallel --filter @f1/web --filter @f1/server dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @f1/server start",
    "type-check": "pnpm -r type-check && tsc -p tsconfig.tools.json",
    "test": "pnpm --filter @f1/shared --filter @f1/database build && vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:cross": "pnpm build && playwright test --config playwright.cross.config.ts",
    "data:verify-p32": "tsx scripts/verify-p32.ts",
    "test:database": "pnpm --filter @f1/database build && tsx scripts/test-database.ts",
    "test:game-database": "pnpm --filter @f1/shared --filter @f1/database build && tsx scripts/test-game-database.ts",
    "game:analyze": "pnpm --filter @f1/shared --filter @f1/database build && tsx scripts/analyze-game-pools.ts",
    "game:smoke": "pnpm --filter @f1/shared --filter @f1/database build && tsx scripts/smoke-game-api.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "tsx scripts/register-migration.ts",
    "db:check": "tsx scripts/check-environment.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "data:drivers": "tsx scripts/import-drivers.ts",
    "data:races": "tsx scripts/import-races.ts",
    "data:aliases": "tsx scripts/import-aliases.ts",
    "data:stats": "tsx scripts/calculate-stats.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:import": "tsx scripts/import-history.ts",
    "data:audit": "tsx scripts/audit-history.ts",
    "data:pole-audit": "pnpm --filter @f1/database build && tsx scripts/audit-poles.ts",
    "data": "pnpm data:pole-audit",
    "data:poles": "pnpm --filter @f1/database build && tsx scripts/publish-poles.ts",
    "game:pole-smoke": "pnpm --filter @f1/shared --filter @f1/database build && tsx scripts/smoke-poles-api.ts",
    "data:check-legacy": "tsx scripts/check-legacy-snapshot.ts",
    "data:review-candidates": "tsx scripts/review-f1db.ts",
    "data:replay-reviews": "tsx scripts/replay-reviews.ts",
    "test:e2e:p4b": "pnpm build && tsx scripts/test-p4b-browser.ts",
    "test:production": "tsx scripts/test-production-browser.ts",
    "browsers:probe": "tsx scripts/probe-browsers.ts",
    "release": "pnpm release:check",
    "security": "pnpm security:scan",
    "test:e2e:p4b:visual": "pnpm build && tsx scripts/test-p4b-visual.ts",
    "test:e2e:p4b:visual:create": "pnpm build && tsx scripts/test-p4b-visual.ts --create",
    "data:check-inputs": "tsx scripts/check-data-inputs.ts",
    "verify:quick": "tsx scripts/verify.ts quick",
    "verify:standard": "tsx scripts/verify.ts standard",
    "verify:full": "tsx scripts/verify.ts full",
    "verify:baseline": "tsx scripts/verify.ts baseline"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@f1/database": "workspace:*",
    "@f1/shared": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "selfsigned": "^5.5.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "5.0.3",
    "vue": "~3.5.43",
    "zod": "^4.0.0"
  }
}
