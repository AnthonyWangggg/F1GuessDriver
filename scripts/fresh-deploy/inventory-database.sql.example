\set ON_ERROR_STOP on
BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
SET LOCAL statement_timeout = '5s';
SET LOCAL lock_timeout = '1s';
SELECT current_database(), current_user, inet_server_addr(), inet_server_port(), pg_is_in_recovery();
SELECT system_identifier FROM pg_control_system();
SELECT oid, datname, pg_get_userbyid(datdba) AS owner, datallowconn, datacl
FROM pg_database WHERE datname = 'f1guess_prod';
SELECT oid, rolname, rolcanlogin, rolsuper, rolcreatedb, rolcreaterole, rolreplication, rolbypassrls
FROM pg_roles
WHERE rolname IN ('f1guess_app','f1guess_maint','f1guess_backup','f1guess_v3_migrate_20261110','f1guess_v3_app_20261110');
SELECT roleid::regrole, member::regrole, admin_option, inherit_option, set_option
FROM pg_auth_members
WHERE roleid IN (SELECT oid FROM pg_roles WHERE rolname IN
  ('f1guess_app','f1guess_maint','f1guess_backup','f1guess_v3_migrate_20261110','f1guess_v3_app_20261110'))
   OR member IN (SELECT oid FROM pg_roles WHERE rolname IN
  ('f1guess_app','f1guess_maint','f1guess_backup','f1guess_v3_migrate_20261110','f1guess_v3_app_20261110'));
SELECT dbid, refobjid::regrole AS role, deptype, count(*) AS dependencies
FROM pg_shdepend
WHERE refclassid = 'pg_authid'::regclass AND refobjid IN (SELECT oid FROM pg_roles WHERE rolname IN
  ('f1guess_app','f1guess_maint','f1guess_backup','f1guess_v3_migrate_20261110','f1guess_v3_app_20261110'))
GROUP BY dbid, refobjid, deptype ORDER BY dbid, refobjid, deptype;
SELECT datname, usename, count(*) FROM pg_stat_activity
WHERE datname='f1guess_prod' GROUP BY datname, usename;
ROLLBACK;
