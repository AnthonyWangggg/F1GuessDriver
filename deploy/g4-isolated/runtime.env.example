# Isolated Linux only: reviewed copy becomes /var/tmp/f1-g4/env/blue.test.env, never production.
NODE_ENV=test
HOST=127.0.0.1
G4_SLOT=blue
PORT=55447
DATABASE_URL=postgresql://f1_bo3_test_app@127.0.0.1:55439/f1_bo3_test_phase_g4_linux
DB_POOL_MAX=5
GAME_DATASET_VERSION=identity-fixture-v3
TRUST_PROXY=loopback
ALLOWED_ORIGINS=http://127.0.0.1:55449
COOKIE_SECURE=false
MAIL_DELIVERY_ENABLED=false
AUTH_HASH_CONCURRENCY=1
IDENTITY_ENABLED=true
POINTS_ENABLED=true
MODES_ENTRY_ENABLED=true
QUICK_V2_ENABLED=true
DAILY_V2_ENABLED=true
BO3_ENABLED=true
BO3_RECOVERY_ENABLED=true
# Inject an ephemeral TEST IDENTITY_KEYRING_JSON through the reviewed secret file.
# R must also supply the NEW standalone cluster's SCRAM password in DATABASE_URL.
# No key is supplied here: startup must fail until a valid test keyring is provided.
# Green: G4_SLOT=green PORT=55448. Recovery-only phase: BO3_ENABLED=false, recovery stays true.
# Test rule activation/fixtures must be created only by the reviewed isolated fixture runner.
