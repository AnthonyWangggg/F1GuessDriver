server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    @AUTH@
    access_log /var/log/nginx/f1-dual-@ENV@.access.log;
    error_log /var/log/nginx/f1-dual-@ENV@.error.log;
    root /srv/f1-dual/state/@ENV@/active/current/apps/web/dist;
    open_file_cache off;
    location = /.f1-deploy-version {
        allow 127.0.0.1;
        deny all;
        alias /srv/f1-dual/state/@ENV@/active/version.txt;
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
    location /assets/ {
        try_files $uri =404;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:@PORT@;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
    }
}
