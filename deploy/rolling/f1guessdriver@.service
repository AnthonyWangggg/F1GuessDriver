[Unit]
Description=Driver Guess API %i
After=network.target postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=f1guess
Group=f1guess
WorkingDirectory=/opt/f1guessdriver/rolling/slots/%i
EnvironmentFile=/etc/f1guessdriver/p4d.env
# Last EnvironmentFile overrides PORT and dataset, never Cookie identity.
EnvironmentFile=/opt/f1guessdriver/rolling/slots/%i.env
ExecStart=/usr/bin/node /opt/f1guessdriver/rolling/slots/%i/apps/server/dist/index.js
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 15 --retry-all-errors --retry-delay 1 --connect-timeout 1 --max-time 2 http://127.0.0.1:${PORT}/api/ready
TimeoutStartSec=60
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
# G1 provisional budget: Argon2 64MiB x 1, bounded queue. Linux cgroup validation pending.
MemoryHigh=384M
MemoryMax=512M
CPUQuota=100%
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
